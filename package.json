{
  "name": "shopify-payment-extension",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "config:link": "shopify app config link",
    "config:use": "shopify app config use",
    "deploy": "shopify app deploy",
    "dev": "shopify app dev --use-localhost",
    "dev:tunnel": "shopify app dev",
    "docker-start": "npm run start",
    "env": "shopify app env",
    "generate": "shopify app generate",
    "graphql-codegen": "graphql-codegen",
    "lint": "tsc --noEmit; eslint --cache --cache-location ./node_modules/.cache/eslint .; prettier --check .",
    "shopify": "shopify",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "vite": "vite",
    "test:unit:watch": "DEBUG_PRINT_LIMIT=99999999999999 vitest",
    "test:unit": "vitest run",
    "test:fetch-users": "tsx tests/e2e/fetch-users.ts",
    "test:e2e": "playwright test"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@react-router/fs-routes": "^7.17.0",
    "@react-router/node": "^7.17.0",
    "@react-router/serve": "^7.17.0",
    "@shopify/app-bridge-react": "^4.2.10",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-api": "^13.0.0",
    "@shopify/shopify-app-react-router": "^1.2.0",
    "@shopify/shopify-app-session-storage-drizzle": "^4.0.0",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.41",
    "javy": "^0.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@react-router/dev": "^7.17.0",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/cli": "^4.1.0",
    "@shopify/polaris-types": "1.0.7",
    "@shopify/shopify-app-session-storage-memory": "^6.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vercel/react-router": "^1.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "undici": "6.13.0"
  },
  "overrides": {
    "undici": "6.13.0"
  },
  "author": "Jake He"
}
