  "workspaces": [
    "extensions/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@shopify/cli": "^4.1.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5"
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "author": "Jake He"
