{
  "name": "shopify-payment-extension",
  "private": true,
  "scripts": {
    "dev": "shopify app dev",
    "deploy": "shopify app deploy",
    "shopify": "shopify",
    "test": "npm run test:function",
    "test:function": "npm run test --workspace=payment-customization",
    "test:e2e": "playwright test",
