# Copy to .env for local development. In production these are set in the
# Vercel project's Environment Variables.

# Shopify app credentials (from the Partner Dashboard).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# The app's public URL. Locally this is injected by `shopify app dev`.
# In production set this to your Vercel domain, e.g. https://your-app.vercel.app
SHOPIFY_APP_URL=

# Comma-separated access scopes (kept in sync with shopify.app.toml).
SCOPES=read_customers,read_payment_customizations,read_translations,write_payment_customizations

# Neon Postgres connection string (used by Drizzle for Shopify session storage).
# Use the pooled connection string from the Neon dashboard — the URL only, not the
# `psql '...'` shell command Neon shows in the copy button.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Optional: only set when developing against a custom shop domain.
# SHOP_CUSTOM_DOMAIN=
