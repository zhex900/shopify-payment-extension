{
  "compilerOptions": {
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["extensions/**/*.ts", "tests/**/*.ts", "playwright.config.ts", ".graphqlrc.ts"]
}
